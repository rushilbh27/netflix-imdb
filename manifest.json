{
  "manifest_version": 3,
  "name": "Netflix IMDb Ratings",
  "version": "1.0.0",
  "description": "Shows IMDb, Rotten Tomatoes and Metacritic ratings on Netflix cards and detail pages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.omdbapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Netflix IMDb Ratings"
  }
}
